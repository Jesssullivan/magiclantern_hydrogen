# magiclantern_hydrogen — direnv configuration
# =============================================
#
# Loads the Nix devShell from flake.nix and wires the Flywheel attic cache
# substituter when an operator-provided endpoint is available. This mirrors
# the contract in ../GloriousFlywheel/.envrc.
#
# Prerequisites:
#   - direnv (brew install direnv) + nix-direnv recommended
#   - Nix with flakes enabled
#   - direnv hook in your shell: eval "$(direnv hook fish)" (or zsh/bash)
#
# Setup:
#   direnv allow

# =============================================================================
# Local .env (gitignored). Use for ATTIC_PUBLIC_KEY override, etc.
# =============================================================================
dotenv_if_exists

# =============================================================================
# Flywheel attic cache attachment (optional, opt-in)
# =============================================================================
# When ATTIC_SERVER + ATTIC_CACHE + ATTIC_PUBLIC_KEY are set (typically via
# .env or operator config), the substituter is appended to NIX_CONFIG so
# local `nix` commands attach to the same cache CI uses.

export ATTIC_SERVER="${ATTIC_SERVER:-https://nix-cache.tinyland.dev}"
export ATTIC_CACHE="${ATTIC_CACHE:-main}"
export ATTIC_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/attic"

export NIX_CONFIG="${NIX_CONFIG:-experimental-features = nix-command flakes}"

attach_attic_nix_config() {
  if [ -n "${ATTIC_SERVER:-}" ] && [ -n "${ATTIC_CACHE:-}" ] && [ -n "${ATTIC_PUBLIC_KEY:-}" ]; then
    local sub="${ATTIC_SERVER%/}/${ATTIC_CACHE}"
    case "${NIX_CONFIG}" in
      *"${sub}"*) ;;
      *) export NIX_CONFIG="${NIX_CONFIG}
extra-substituters = ${sub}
extra-trusted-public-keys = ${ATTIC_PUBLIC_KEY}" ;;
    esac
  fi
}
attach_attic_nix_config

# =============================================================================
# Bazel substrate contract (mirrors GloriousFlywheel)
# =============================================================================
# Routine Bazel work runs through `just bazel-build-cached` and verifies the
# strict cache-attachment contract first. The endpoints below are only
# defined when an operator-provided routable cache is available.

export BAZEL_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/bazel"
export BAZEL_OUTPUT_BASE="${BAZEL_CACHE_DIR}/magiclantern-hydrogen-output"

export BAZEL_REMOTE_CACHE="${BAZEL_REMOTE_CACHE:-}"
export BAZEL_REMOTE_EXECUTOR="${BAZEL_REMOTE_EXECUTOR:-}"
if [ -n "${BAZEL_REMOTE_EXECUTOR}" ]; then
  export GF_BAZEL_SUBSTRATE_MODE="executor-backed"
elif [ -n "${BAZEL_REMOTE_CACHE}" ]; then
  export GF_BAZEL_SUBSTRATE_MODE="shared-cache-backed"
else
  export GF_BAZEL_SUBSTRATE_MODE="compatibility-local-only"
fi

# =============================================================================
# Nix devShell entry
# =============================================================================
if has nix_direnv_version; then
  nix_direnv_version 3.0.0
fi
use flake

# =============================================================================
# Project bin / PATH
# =============================================================================
layout_dir=$(direnv_layout_dir)
mkdir -p "$layout_dir/bin"
PATH_add "$layout_dir/bin"
PATH_add scripts

# =============================================================================
# File watches — reload devShell on these changes
# =============================================================================
watch_file flake.nix
watch_file flake.lock
watch_file .bazelversion
watch_file Justfile

# =============================================================================
# Welcome banner (interactive shells only)
# =============================================================================
if [ -t 1 ]; then
  echo ""
  echo "magiclantern_hydrogen — research fork dev shell"
  echo "==============================================="
  echo "In-scope platforms: 5D2.212  5D3.113  5D3.123  5D4.133"
  echo "Bazel mode:         ${GF_BAZEL_SUBSTRATE_MODE}"
  if [ -n "${BAZEL_REMOTE_CACHE}" ]; then
    echo "Cache:              ${BAZEL_REMOTE_CACHE}"
  else
    echo "Cache:              unset (compatibility-local-only)"
  fi
  echo ""
  echo "Quick commands:"
  echo "  just              — list all recipes"
  echo "  just info         — toolchain versions, cache status"
  echo "  just build PLATFORM=5D3.123"
  echo "  just qemu-test PLATFORM=5D3"
  echo "  just ci-local     — full local CI mirror"
  echo ""
fi
